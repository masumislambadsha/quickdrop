# Copy to .env.local and adjust for local development.
# NEVER put STRIPE_SECRET_KEY, CLOUDINARY_API_SECRET or any secret in frontend env files.
NEXT_PUBLIC_API_BASE_URL=https://courier-and-logistics.vercel.app/api/v1
# Local backend: NEXT_PUBLIC_API_BASE_URL=http://localhost:5000/api/v1
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000
# Production frontend URL (used for metadata + sitemap). Example:
# NEXT_PUBLIC_FRONTEND_URL=https://quickdrop-frontend.vercel.app
# Cloudinary unsigned avatar uploads (B7A7 file-upload requirement).
# API_KEY is public by design (sent with unsigned uploads); API_SECRET stays server-side only.
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=
NEXT_PUBLIC_CLOUDINARY_API_KEY=
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=
